# Server-side environment (Vercel Functions). Set these in your Vercel project settings.
# Never commit real values to version control.
#
# Copy this file to `.env`. `vercel dev` only reads `.env` (not `.env.local`).

GOLD_PRICE_API_URL=https://api.gold-api.com/price/XAU

# Swap aggregators (server-side only - the keys never reach the browser).
# Both providers are queried in parallel and the best executable quote wins.
# Li.Fi also works keyless (rate-limited), so LIFI_API_KEY is optional.
LIFI_API_KEY=
ONEINCH_API_KEY=
# Optional: pin a single provider (disables best-of comparison).
SWAP_PROVIDER=
# Optional: override the 1inch API host (defaults to https://api.1inch.com).
ONEINCH_API_URL=

# Client-side environment (Vite). Prefix with VITE_ to expose to the browser.
# Leave empty to call the quotes API on the same origin.
# During local development on a phone, point this at your machine's LAN IP,
# because "localhost" inside the WebView resolves to the phone itself.
VITE_QUOTES_API_BASE_URL=

# Optional dedicated Polygon RPC endpoint (e.g. Alchemy/Infura).
# Falls back to public RPCs when unset.
VITE_POLYGON_RPC_URL=

# Set to "true" to use the local trade simulator. No transactions are sent and no funds move.
VITE_SIMULATED_TRADES=false